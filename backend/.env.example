ENV=local

# Supabase > Connect > Transaction pooler (6543). ?pgbouncer=true 붙이지 말 것
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 secret key (Storage 서명 URL 발급·파일 삭제). 앱/웹에 넣지 말 것
SUPABASE_SECRET_KEY=

STORAGE_AUDIO_BUCKET=audio
STORAGE_IMPORT_BUCKET=kakao-imports
