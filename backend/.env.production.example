# 운영 환경 변수 예시 — 실제 값은 배포처 설정(Secrets)에 입력, 이 파일에 X
# API 서버·워커 둘 다 같은 값
# 필수 표시 없는 항목: 기본값 있음

# ── 기본 ──
# 필수. 빠지면 local → /v1/dev 열림 · 개발용 동의 문구 사용
ENV=production

# ── Supabase (운영 프로젝트, 개발 프로젝트와 분리) ──
# 필수. Transaction pooler 주소 (Supabase → Connect)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 필수
SUPABASE_URL=https://<project-ref>.supabase.co
# 필수. 앱에 넣는 키와 같음
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 필수 (서버 전용, 앱 X). Storage 서명 URL · 파일 삭제 · 탈퇴 계정 삭제
SUPABASE_SECRET_KEY=sb_secret_xxx

STORAGE_AUDIO_BUCKET=audio
STORAGE_IMPORT_BUCKET=kakao-imports

# ── 보안 ──
# 필수. 없으면 시작 중단. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
CURSOR_SECRET=<긴 임의 문자열>
# 앞단 프록시 수 (배포처 로드밸런서 1단 → 1). 0 → X-Forwarded-For 무시
TRUSTED_PROXY_HOPS=1
# 웹 앱 주소 (쉼표 구분). 앱만 → 비움
CORS_ORIGINS=https://<웹 도메인>

# ── AI ──
# 필수. 운영은 real만 허용
AI_PROVIDER=real
# 필수. 유료 등급 키만 (무료 등급: 입력 데이터 Google 학습·검토 가능 → 실사용자 데이터 X)
GEMINI_API_KEY=<유료 등급 키>
GEMINI_MODEL=gemini-3.1-flash-lite

# ── 카카오 ──
# 서버 전용. 탈퇴 때 카카오 연결 끊기 (없으면 건너뜀)
KAKAO_ADMIN_KEY=<카카오 Admin 키>

# ── 삭제 실행 ──
# ⚖️ 법률 확인 전 false. false → 탈퇴 접수만, 계정 삭제 X (같은 계정 재가입 불가)
DELETION_EXECUTE_ENABLED=false

# ── 초대 ──
# 앱 링크 도메인 정해지면. 베타는 초대 코드 공유라 그대로 둬도 됨
# INVITE_BASE_URL=https://<도메인>/invite
